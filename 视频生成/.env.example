# OpenProxy / Seedance API 密钥（仅存入本机 .env，勿提交）
SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=https://openproxy-cn.zuoyebang.cc
SEEDANCE_TASKS_PATH=/openproxy/rp/doubao/v3/contents/generations/tasks
SEEDANCE_DEFAULT_MODEL=doubao-seedance-1-0-pro-250528

# 轮询与网络
SEEDANCE_POLL_INITIAL_SECONDS=3
SEEDANCE_POLL_MAX_SECONDS=20
SEEDANCE_REQUEST_TIMEOUT_SECONDS=90
SEEDANCE_DOWNLOAD_TIMEOUT_SECONDS=600

# 本地保护限制
VIDEO_MAX_BATCH_ITEMS=5
VIDEO_MAX_PROMPT_CHARS=4000
VIDEO_MAX_DOWNLOAD_BYTES=524288000
